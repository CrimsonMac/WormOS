 				       false);
 		if (adev) {
-			adev->flags.match_driver = true;
-			if (device_attach(&adev->dev) >= 0)
-				device_init_wakeup(&adev->dev, true);
-			else
-				dev_dbg(&adev->dev, "No driver\n");
+			acpi_bus_fixed_platform_device(adev);
+			device_init_wakeup(&adev->dev, true);
 		}
