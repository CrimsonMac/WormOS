 EXPORT_SYMBOL_GPL(acpi_bus_register_early_device);
 
+/*
+ * The button driver is a platform driver, but the fixed-feature buttons have
+ * no ACPI handle, so acpi_create_platform_device() (which reads resources)
+ * skips them: register their platform device here.
+ */
+static void acpi_bus_fixed_platform_device(struct acpi_device *adev)
+{
+	struct platform_device_info pdevinfo = {
+		.name = dev_name(&adev->dev),
+		.id = PLATFORM_DEVID_NONE,
+		.fwnode = acpi_fwnode_handle(adev),
+	};
+	struct platform_device *pdev;
+
+	adev->flags.match_driver = true;
+	pdev = platform_device_register_full(&pdevinfo);
+	if (IS_ERR(pdev))
+		dev_err(&adev->dev, "platform device creation failed: %ld\n",
+			PTR_ERR(pdev));
+	else
+		acpi_device_set_enumerated(adev);
+}
+
 static void acpi_bus_scan_fixed(void)
 {
 	if (!(acpi_gbl_FADT.flags & ACPI_FADT_POWER_BUTTON)) {
@@ -2639,11 +2663,8 @@
