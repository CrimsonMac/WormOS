name=dosfstools
version=4.2
description="mkfs.fat and fsck.fat: create and check FAT file systems (USB sticks)"
depends=(glibc)
source=(https://github.com/dosfstools/dosfstools/releases/download/v$version/dosfstools-$version.tar.gz)
sha256=(64926eebf90092dca21b14259a5301b7b98e7b1943e8a201c7d726084809b527)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sbindir=/usr/sbin --enable-compat-symlinks --without-udev
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/locale" \
		"$pkgdir/usr/share/doc"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/dosfstools/COPYING"
}
