name=libnftnl
version=1.3.2
description="Netlink interface to the nf_tables subsystem"
depends=(glibc libmnl)
# Signed by the Netfilter Core Team (8C5F7146A1757A65E2422A94D70D1A666ACF2B21).
source=(https://www.netfilter.org/projects/libnftnl/files/libnftnl-$version.tar.xz)
sha256=(c97abc3409f8fa396b4462b2bb7f147a3a47a4ddc97cfa0b2f18890c9cfde8b0)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--disable-static
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
}
