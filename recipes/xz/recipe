name=xz
version=5.8.4
description="XZ Utils: xz and lzma compression"
depends=(glibc)
# Signed by Lasse Collin (3690C240CE51B4670D30AD1C38EE757D69184620).
source=(https://github.com/tukaani-project/xz/releases/download/v$version/xz-$version.tar.xz)
sha256=(4ce24038fd4221e0d13bc1a2de7a4db56e90b92b3bf75321f6c14be73f65de4b)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--disable-static --disable-doc --disable-nls
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/doc"
}
