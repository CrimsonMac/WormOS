name=strace
version=7.3
description="Traces the system calls and signals of a program"
depends=(glibc)
# Signed by Dmitry V. Levin (7BECFE3AF7B280BB52FF77F104BA4521C996DDE1).
source=(https://github.com/strace/strace/releases/download/v$version/strace-$version.tar.xz)
sha256=(529634c40910895a9a1f3c5c1e65da2ca9ed72fb158dfc4bcc89efdf05e39b72)

build() {
	# No 32-bit personalities: the toolchain has no 32-bit headers.
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--enable-mpers=no --disable-gcc-Werror --without-libunwind --without-libdw
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man"
}
