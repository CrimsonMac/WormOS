name=kvmtool
version=0.0.20260812
description="Small virtual machine monitor for KVM (lkvm), used by bh open --vm"
depends=()
# No releases: a snapshot of the kvmtool repository at kernel.org.
commit=f67bc0bdae9433a9cfd05e65ea2c1bb6102566d9
source=(https://git.kernel.org/pub/scm/linux/kernel/git/will/kvmtool.git/snapshot/kvmtool-$commit.tar.gz)
sha256=(d9b40dc5ee8d3cac5e3c4c4dd4e0c5837891d9a60cd067222771ec838e4ade37)

build() {
	# kvmtool embeds its own guest init (unused here); strip it first, or
	# its debug information carries build paths into lkvm's data.
	make -j"$JOBS" ARCH=x86_64 CC="$CC" LD="$LD" guest/init guest/pre_init
	"$STRIP" --strip-all guest/init guest/pre_init
	make -j"$JOBS" ARCH=x86_64 CC="$CC" LD="$LD" lkvm-static
}

package() {
	install -Dm755 lkvm-static "$pkgdir/usr/bin/lkvm"
}
