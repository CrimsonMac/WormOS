# WormOS Amnesia window theme for labwc: the WormOS theme in greys.
border.width: 1
window.titlebar.padding.width: 4
window.titlebar.padding.height: 6

window.active.border.color: #8a8a8a
window.inactive.border.color: #2a2a2a
window.active.title.bg.color: #1c1c1c
window.inactive.title.bg.color: #141414
window.active.label.text.color: #ececec
window.inactive.label.text.color: #7d7d7d
window.label.text.justify: center
window.active.button.unpressed.image.color: #ececec
window.inactive.button.unpressed.image.color: #7d7d7d
window.button.hover.bg.color: #ffffff30
window.button.hover.bg.corner-radius: 4

window.active.shadow.size: 40
window.inactive.shadow.size: 20
window.active.shadow.color: #00000080
window.inactive.shadow.color: #00000050

menu.border.width: 1
menu.border.color: #6e6e6e
menu.items.bg.color: #1c1c1c
menu.items.text.color: #ececec
menu.items.active.bg.color: #4d4d4d
menu.items.active.text.color: #ffffff
menu.items.padding.x: 10
menu.items.padding.y: 5
menu.separator.color: #383838
menu.title.bg.color: #141414
menu.title.text.color: #d6d6d6

osd.bg.color: #1c1c1c
osd.border.color: #8a8a8a
osd.border.width: 1
osd.label.text.color: #ececec
osd.window-switcher.style-classic.item.active.bg.color: #ffffff30
osd.window-switcher.style-classic.item.active.border.color: #bdbdbd
