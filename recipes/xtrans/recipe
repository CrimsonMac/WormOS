name=xtrans
version=1.6.0
description="X transport library sources (for building libX11)"
# Signed by Alan Coopersmith (2F7DBCAD5B30E668BBD516C1CFDF148828C642A7).
source=(https://www.x.org/releases/individual/lib/xtrans-$version.tar.xz)
sha256=(faafea166bf2451a173d9d593352940ec6404145c5d1da5c213423ce4d359e92)
sysroot_files=(usr/share/pkgconfig usr/share/aclocal)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/doc"
}
