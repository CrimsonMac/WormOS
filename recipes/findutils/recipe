name=findutils
version=4.11.0
description="GNU find and xargs"
depends=(glibc)
source=(https://ftp.gnu.org/gnu/findutils/findutils-$version.tar.xz)
sha256=(bfd19cb06cc71f3352d567e90284d8cdac02ac89774bbeadf0b533b0c11432fd)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--disable-nls --localstatedir=/var/lib/locate
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/locale" \
		"$pkgdir/usr/share/doc"
	# No locate database (it would need a scheduler to stay current).
	rm -rf "$pkgdir/usr/bin/locate" "$pkgdir/usr/bin/updatedb" "$pkgdir/usr/libexec" \
		"$pkgdir/var"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/findutils/COPYING"
}
