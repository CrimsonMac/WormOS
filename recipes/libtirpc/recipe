name=libtirpc
version=1.3.8
description="Transport-independent RPC library (Sun RPC), needed by open-vm-tools"
depends=(glibc)
# Upstream publishes no signature: checksum pinned from the release download
# (its SHA-512 matches Arch Linux's package).
source=(https://downloads.sourceforge.net/project/libtirpc/libtirpc/$version/libtirpc-$version.tar.bz2)
sha256=(8839959bfcc7a0f4c609d8e4f53f1c67ae33de23775ec35beb39ff15adf11920)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sysconfdir=/etc --disable-gssapi --disable-static
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
	rm -rf "$pkgdir/usr/share/man"
}
