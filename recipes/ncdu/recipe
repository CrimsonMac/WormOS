name=ncdu
version=1.22
description="Disk usage viewer: finds what fills the disk"
depends=(glibc ncurses)
# Signed by Yorhel (74460D32B80810EBA9AFA2E962394C698C2739FA).
source=(https://dev.yorhel.nl/download/ncdu-$version.tar.gz)
sha256=(0ad6c096dc04d5120581104760c01b8f4e97d4191d6c9ef79654fa3c691a176b)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man"
}
