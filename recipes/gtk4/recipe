name=gtk4
version=4.24.1
description="GTK 4 widget toolkit (Wayland backend)"
depends=(glibc glib pango cairo harfbuzz fribidi fontconfig freetype gdk-pixbuf libpng
	libjpeg-turbo libtiff libepoxy graphene libxkbcommon wayland libdrm mesa
	shared-mime-info)
# GNOME publishes no signatures; matches the release's sha256sum file.
source=(https://download.gnome.org/sources/gtk/${version%.*}/gtk-$version.tar.xz)
sha256=(e98abe720e16129c8c0f50761dee0a2e9ae2478055e31018f6cf977fcf6513e9)

build() {
	# Wayland only, no Vulkan (none on the host), media playback, printing
	# or desktop search. SVG icons use GTK's own renderer.
	meson_build -Dx11-backend=false -Dwayland-backend=true -Dbroadway-backend=false \
		-Dmedia-gstreamer=disabled -Dprint-cups=disabled -Dprint-cpdb=disabled \
		-Dvulkan=disabled -Dcloudproviders=disabled -Dsysprof=disabled \
		-Dtracker=disabled -Dcolord=disabled -Daccesskit=disabled \
		-Dintrospection=disabled -Ddocumentation=false -Dman-pages=false \
		-Dbuild-demos=false -Dbuild-testsuite=false -Dbuild-examples=false \
		-Dbuild-tests=false
}

package() {
	meson_package
	rm -rf "$pkgdir/usr/share/locale" "$pkgdir/usr/share/gettext" \
		"$pkgdir/usr/share/bash-completion" "$pkgdir/usr/share/gtk-4.0/valgrind"
	# Tools for developers of GTK programs.
	rm -f "$pkgdir"/usr/bin/gtk4-{builder,image,path,rendernode}-tool
}
