name=mtr
version=0.96
description="Traceroute and ping combined, live (mtr; mtr-packet sends the probes)"
depends=(glibc ncurses)
# Upstream publishes no signature: checksum pinned from the tagged archive.
source=(https://github.com/traviscross/mtr/archive/v$version/mtr-$version.tar.gz)
sha256=(73e6aef3fb6c8b482acb5b5e2b8fa7794045c4f2420276f035ce76c5beae632d)
# Raw sockets for ICMP probes; mtr itself runs unprivileged.
caps=("usr/sbin/mtr-packet cap_net_raw=ep")

build() {
	echo "$version" > .tarball-version
	./bootstrap.sh > /dev/null
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sbindir=/usr/sbin --without-gtk --without-jansson --disable-bash-completion \
		--without-libcap
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/mtr/COPYING"
}
