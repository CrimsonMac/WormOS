name=lua
version=5.4.9
description="Lua scripting language (shared library and interpreter)"
depends=(glibc)
# lua.org publishes no signature; matches the checksum on its download page.
source=(https://www.lua.org/ftp/lua-$version.tar.gz)
sha256=(2335b6c582a52654f94612bf10d2f4672805d05329aa6568b1d8cd9e5c6fb8e6)

build() {
	# Upstream builds only a static library; the shared one is linked from
	# its objects, and the interpreter against it.
	make -C src CC="$CC" AR="$AR rc" RANLIB="$RANLIB" MYCFLAGS="$CFLAGS -fPIC" \
		MYLDFLAGS="$LDFLAGS" SYSCFLAGS=-DLUA_USE_LINUX SYSLIBS="-Wl,-E" \
		liblua.a lua.o
	$CC $LDFLAGS -shared -Wl,-soname,liblua.so.${version%.*} -o src/liblua.so.$version \
		-Wl,--whole-archive src/liblua.a -Wl,--no-whole-archive -lm
	ln -sf liblua.so.$version src/liblua.so
	$CC $LDFLAGS -o src/lua src/lua.o -Lsrc -llua -lm
}

package() {
	install -Dm755 src/lua "$pkgdir/usr/bin/lua"
	install -Dm755 src/liblua.so.$version "$pkgdir/usr/lib/liblua.so.$version"
	ln -s liblua.so.$version "$pkgdir/usr/lib/liblua.so.${version%.*}"
	ln -s liblua.so.$version "$pkgdir/usr/lib/liblua.so"
	install -d "$pkgdir/usr/include"
	install -m644 src/{lua.h,luaconf.h,lualib.h,lauxlib.h} src/lua.hpp "$pkgdir/usr/include/"
	install -d "$pkgdir/usr/lib/pkgconfig"
	cat > "$pkgdir/usr/lib/pkgconfig/lua.pc" <<-PC
	prefix=/usr
	libdir=\${prefix}/lib
	includedir=\${prefix}/include

	Name: Lua
	Description: Lua scripting language
	Version: $version
	Libs: -L\${libdir} -llua
	Libs.private: -lm
	Cflags: -I\${includedir}
	PC
	install -d "$pkgdir/usr/share/licenses/lua"
	sed -n '/^\* Copyright (C)/,/SOFTWARE\./p' src/lua.h > "$pkgdir/usr/share/licenses/lua/COPYRIGHT"
}
