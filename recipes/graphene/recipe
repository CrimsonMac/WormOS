name=graphene
version=1.10.8
description="Vector and matrix math library used by GTK"
depends=(glibc glib)
# GNOME publishes no signatures; matches the release's sha256sum file.
source=(https://download.gnome.org/sources/graphene/${version%.*}/graphene-$version.tar.xz)
sha256=(a37bb0e78a419dcbeaa9c7027bcff52f5ec2367c25ec859da31dfde2928f279a)

build() {
	meson_build -Dgtk_doc=false -Dgobject_types=true -Dintrospection=disabled \
		-Dtests=false -Dinstalled_tests=false
}

package() {
	meson_package
}
