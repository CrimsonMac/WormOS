name=foot
version=1.28.0
description="Fast, lightweight Wayland terminal"
depends=(glibc fcft pixman wayland libxkbcommon fontconfig)
# Upstream publishes no signature: checksum pinned from the release download.
source=(foot-$version.tar.gz::https://codeberg.org/dnkl/foot/archive/$version.tar.gz)
sha256=(4296be402b5684d049534598e69db92b918f92beac9dab76b585207045f0b037)

build() {
	meson_build -Ddocs=disabled -Dthemes=false -Dime=false \
		-Dgrapheme-clustering=disabled -Dtests=false -Dterminfo=disabled \
		-Ddefault-terminfo=xterm-256color -Dutmp-backend=none
}

package() {
	meson_package
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/zsh" \
		"$pkgdir/usr/share/fish" "$pkgdir/usr/share/bash-completion" \
		"$pkgdir/usr/lib/systemd"
	# The WormOS configuration comes with wormos-desktop.
	rm -rf "$pkgdir/etc/xdg/foot"
}
