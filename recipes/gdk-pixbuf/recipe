name=gdk-pixbuf
version=2.44.8
description="Image loading library for GTK"
depends=(glibc glib libpng libjpeg-turbo libtiff)
# GNOME publishes no signatures; matches the release's sha256sum file.
source=(https://download.gnome.org/sources/gdk-pixbuf/${version%.*}/gdk-pixbuf-$version.tar.xz)
sha256=(919f529512961a12e81cd4b4b466a48c3933469e7f9a310c6513cd4fb252ba3c)

build() {
	# The loaders are built into the library, so no loader cache has to be
	# generated. glycin (sandboxed loaders written in Rust) is not used.
	meson_build -Dpng=enabled -Djpeg=enabled -Dtiff=enabled -Dgif=disabled \
		-Dothers=disabled -Dglycin=disabled -Dandroid=disabled \
		-Dbuiltin_loaders=all -Dgtk_doc=false -Ddocumentation=false \
		-Dintrospection=disabled -Dman=false -Dtests=false \
		-Dinstalled_tests=false -Dthumbnailer=disabled
}

package() {
	meson_package
	rm -rf "$pkgdir/usr/share/locale" "$pkgdir/usr/share/thumbnailers"
}
