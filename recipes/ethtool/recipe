name=ethtool
version=7.2
description="Query and change network card settings"
depends=(glibc libmnl)
source=(https://www.kernel.org/pub/software/network/ethtool/ethtool-$version.tar.xz)
sha256=(44256ddf4631ed08d816b7b8725f4b2e0f05e96b8c7ca64ee5c81449da2b6507)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sbindir=/usr/sbin
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/locale" \
		"$pkgdir/usr/share/doc"
	rm -rf "$pkgdir/usr/share/bash-completion"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/ethtool/COPYING"
}
