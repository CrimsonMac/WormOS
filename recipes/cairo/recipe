name=cairo
version=1.18.6
release=2
description="2D graphics library"
depends=(glibc pixman freetype fontconfig libpng zlib glib)
# Checksum list signed by Emmanuele Bassi (53EF3DC3B63E2899271BD26322E8091EEA11BBB7).
source=(https://cairographics.org/releases/cairo-$version.tar.xz)
sha256=(1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4)

build() {
	# cairo-gobject (glib) is needed by GTK.
	meson_build -Dfontconfig=enabled -Dfreetype=enabled -Dpng=enabled \
		-Dzlib=enabled -Dxcb=disabled -Dxlib=disabled -Dquartz=disabled \
		-Ddwrite=disabled -Dtee=disabled -Dtests=disabled -Dlzo=disabled \
		-Dglib=enabled -Dspectre=disabled -Dsymbol-lookup=disabled \
		-Dgtk_doc=false
}

package() {
	meson_package
}
