name=nano
version=9.3
description="A small, friendly text editor"
depends=(glibc ncurses)
# Signed by Benno Schulenberg (168E6F4297BFD7A79AFD4496514BBE2EB8E1961F).
source=(https://www.nano-editor.org/dist/v9/nano-$version.tar.xz)
sha256=(a9affc52c9596ee0682bcdd4ceb3c0b235eb221d83d733dfd9b0dff45897cb0d)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sysconfdir=/etc --disable-nls --disable-libmagic --enable-utf8
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/doc"
	install -Dm644 "$recipedir/files/nanorc" "$pkgdir/etc/nanorc"
}
