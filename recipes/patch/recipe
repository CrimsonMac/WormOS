name=patch
version=2.8.1
description="GNU patch: applies diffs to files"
depends=(glibc)
source=(https://ftp.gnu.org/gnu/patch/patch-$version.tar.xz)
sha256=(3240c7959c5347c8ed347e3c4201c0337bf4240d5cf09d68889e58eeaba30e17)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--disable-xattr
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/locale" \
		"$pkgdir/usr/share/doc"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/patch/COPYING"
}
