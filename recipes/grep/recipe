name=grep
version=3.12
description="GNU grep: search text with regular expressions (with -P)"
depends=(glibc pcre2)
source=(https://ftp.gnu.org/gnu/grep/grep-$version.tar.xz)
sha256=(2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--disable-nls --enable-perl-regexp
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/locale" \
		"$pkgdir/usr/share/doc"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/grep/COPYING"
}
