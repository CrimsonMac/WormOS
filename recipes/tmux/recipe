name=tmux
version=3.8
description="Terminal multiplexer"
depends=(glibc ncurses libevent)
source=(https://github.com/tmux/tmux/releases/download/$version/tmux-$version.tar.gz)
sha256=(e79c699c7e949dccd0a4a125e17b8d1261e311b16979dbc8eb34542f3966d82e)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--sysconfdir=/etc
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man"
}
