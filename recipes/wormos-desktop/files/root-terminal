#!/bin/sh
# The root terminal: root's login shell, asking for the root password.
# su - clears the environment, so programs started as root could not find
# the desktop (Ghidra and other graphical wormhole programs quit at once):
# the display goes along (the Wayland socket by its full path and
# Xwayland's display number) to root-shell, which sets it up as root.
# With a command (menu entries of tools that need root), root runs it first.
# Usage: root-terminal [COMMAND]
wayland=
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
	case $WAYLAND_DISPLAY in
	/*) wayland=$WAYLAND_DISPLAY ;;
	*) wayland=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$WAYLAND_DISPLAY ;;
	esac
fi
# Xwayland admits only its own user: add root (it starts Xwayland if needed).
[ -n "${DISPLAY:-}" ] && /usr/lib/worm/x11-allow-root 2>/dev/null
exec su - root -c 'exec /usr/lib/worm/root-shell "$@"' root-shell \
	"$wayland" "${DISPLAY:-}" "${1:-}"
