# Keyboard layout for the desktop, e.g. XKB_DEFAULT_LAYOUT=de or
# XKB_DEFAULT_LAYOUT=us,de with
# XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle,wormos:caps_unlock_on_press.
# Override in ~/.config/labwc/environment.
XKB_DEFAULT_LAYOUT=us
# Caps Lock turns off as the key goes down (/etc/xkb/symbols/wormos).
XKB_DEFAULT_OPTIONS=wormos:caps_unlock_on_press
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24
