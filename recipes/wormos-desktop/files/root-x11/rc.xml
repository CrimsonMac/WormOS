<?xml version="1.0"?>
<!-- The window holding root's X11 programs (root-x11): WormOS's look,
     no root menu, windows placed in the middle. -->
<labwc_config>
  <theme>
    <name>WormOS</name>
    <cornerRadius>6</cornerRadius>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size></font>
  </theme>
  <placement><policy>center</policy></placement>
  <keyboard>
    <default />
  </keyboard>
  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Right" action="Press" />
      <mousebind button="Left" action="Press" />
      <mousebind button="Middle" action="Press" />
    </context>
  </mouse>
</labwc_config>
