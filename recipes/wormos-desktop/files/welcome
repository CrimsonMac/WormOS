#!/bin/sh
# Greet a new terminal: system details, the main commands and a tip.
# welcome --full prints the whole guide.

if [ "${1:-}" = --full ]; then
	cat /usr/share/wormos/guide
	exit
fi

. /etc/os-release
read -r up _ < /proc/uptime
up=${up%.*}
if [ "$up" -ge 86400 ]; then
	uptime="$((up / 86400))d $((up % 86400 / 3600))h"
elif [ "$up" -ge 3600 ]; then
	uptime="$((up / 3600))h $((up % 3600 / 60))m"
else
	uptime="$((up / 60))m"
fi
mem=$(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 }
	END { printf "%.1f / %.1f GiB", (t - a) / 1048576, t / 1048576 }' /proc/meminfo)
if [ -e /etc/worm/anon ]; then anon="on"; else anon="off"; fi

tip=$(awk -v seed="$$$(date +%s)" '
	/^[^#]/ && NF { tips[n++] = $0 }
	END { if (n) { srand(seed); print tips[int(rand() * n)] } }' /usr/share/wormos/tips)

snaps=$(sed -n 's/^count = //p' /run/snap-status 2>/dev/null)

m='\033[35m' b='\033[1m' d='\033[2m' r='\033[0m'
# The logo: a wormhole seen from above, its rings brighter towards the
# core. 24-bit colours; terminals without them pick the nearest.
c1='\033[38;2;91;33;182m' c2='\033[38;2;124;58;237m' c3='\033[38;2;167;139;250m'
c4='\033[38;2;216;180;254m' c5='\033[1;38;2;253;244;255m'
if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ]; then
	m= b= d= r= c1= c2= c3= c4= c5=
fi
printf "\n"
printf "  ${c1}     .-''''''''-.${r}        ${b}%s${r}\n" "$PRETTY_NAME"
printf "  ${c1}   .'${c2}  .-''''-.  ${c1}'.${r}      ${d}─────────────────────────────${r}\n"
printf "  ${c1}  /${c2}  .'${c3} .-''-. ${c2}'.  ${c1}\\\\${r}     ${m}Kernel${r}    Linux %s\n" "$(uname -r)"
printf "  ${c1} |${c2}  |${c3}  (${c4}  ${c5}@${c4}  ${c3})  ${c2}|  ${c1}|${r}     ${m}Uptime${r}    %s\n" "$uptime"
printf "  ${c1}  \\\\${c2}  '.${c3} '-..-' ${c2}.'  ${c1}/${r}     ${m}Memory${r}    %s\n" "$mem"
printf "  ${c1}   '.${c2}  '-....-'  ${c1}.'${r}      ${m}Snapshots${r} %s  ${d}·${r}  ${m}Tor mode${r} %s\n" \
	"${snaps:-0}" "$anon"
printf "  ${c1}     '-........-'${r}\n"
printf "\n"
printf "  ${b}snap now${r}     take a snapshot          ${b}wh install${r}   add software\n"
printf "  ${b}snap list${r}    snapshots, ${b}rewind${r}        ${b}bh open${r}      disposable sandbox\n"
printf "  ${b}worm status${r}  protections              ${b}worm kit${r}     tool kits\n"
printf "  ${b}worm help${r}    every WormOS command     ${b}su -${r}         administration\n"
printf "\n"
# The tip, wrapped at word boundaries to the terminal's width.
if [ -n "$tip" ]; then
	cols=$(stty size 2>/dev/null | cut -d' ' -f2)
	[ "${cols:-0}" -ge 40 ] 2>/dev/null || cols=80
	printf '%s\n' "$tip" | fold -s -w $((cols - 9)) | {
		read -r line
		printf "  ${m}Tip:${r} %s\n" "$line"
		while read -r line; do
			printf '       %s\n' "$line"
		done
	}
fi
printf "  ${d}welcome --full shows the guide; touch ~/.hushlogin hides this.${r}\n\n"
