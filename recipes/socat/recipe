name=socat
version=1.8.1.3
description="Multipurpose relay: connects any two byte streams (sockets, files, programs)"
depends=(glibc openssl readline ncurses)
source=(http://www.dest-unreach.org/socat/download/socat-$version.tar.gz)
sha256=(06602ffd591e98c75b3dc1d66f0f19136cc666b0b2d95caad987d6ab2cb28097)

build() {
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--disable-libwrap --enable-openssl --enable-readline
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/info" "$pkgdir/usr/share/locale" \
		"$pkgdir/usr/share/doc"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/socat/COPYING"
}
