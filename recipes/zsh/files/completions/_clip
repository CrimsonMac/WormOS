#compdef clip

if (( CURRENT == 2 )); then
	local -a cmds=('copy:copy text, or standard input' 'paste:print the clipboard'
		'agent:share the clipboard with the VM host')
	_describe -t commands 'clip command' cmds
	return
fi
case $words[2] in
copy) _message 'text (or standard input)' ;;
agent) (( CURRENT == 3 )) && _files -W /dev/virtio-ports ;;
esac
