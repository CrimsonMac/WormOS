#compdef bh blackhole

_bh_names() {
	local -a names=(/var/lib/blackholes/$EUID/*(N/:t))
	_wanted blackholes expl blackhole compadd -a names
}

if (( CURRENT == 2 )); then
	local -a cmds=('open:open a blackhole (a new one, or NAME)'
		'put:copy files into a blackhole' 'list:list blackholes' 'close:close and delete a blackhole')
	_describe -t commands 'bh command' cmds
	return
fi
case $words[2] in
open)
	# Everything after -- is a command run inside.
	local dd=${words[(i)--]}
	if (( dd < CURRENT )); then
		words=("${(@)words[dd+1,-1]}")
		(( CURRENT -= dd ))
		_normal
	elif (( CURRENT == 3 )); then
		_bh_names
	fi
	;;
put) (( CURRENT == 3 )) && _bh_names || _files ;;
close) (( CURRENT == 3 )) && _bh_names ;;
esac
