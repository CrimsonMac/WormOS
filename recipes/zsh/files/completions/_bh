#compdef bh blackhole

_bh_names() {
	local -a names=(/var/lib/blackholes/$EUID/*(N/:t))
	_wanted blackholes expl blackhole compadd -a names
}

if (( CURRENT == 2 )); then
	local -a cmds=('open:open a blackhole (a new one, or NAME)'
		'put:copy files into a blackhole' 'list:list blackholes' 'close:close and delete a blackhole')
	_describe -t commands 'bh command' cmds
	return
fi
case $words[2] in
open)
	# Everything after -- is a command run inside.
	local dd=${words[(i)--]}
	if (( dd < CURRENT )); then
		words=("${(@)words[dd+1,-1]}")
		(( CURRENT -= dd ))
		_normal
	elif [[ $words[CURRENT-1] == --from ]]; then
		local -a srcs=(/var/lib/wormholes/*(N/:t))
		_wanted sources expl 'wormhole' compadd -a srcs
	elif [[ $words[CURRENT-1] == --(memory|pids|cpus) ]]; then
		_message 'value'
	elif [[ $PREFIX == -* ]]; then
		local -a opts=('--net:a network (not the local one)' '--lan:with --net, the local network too'
			'--vm:a virtual machine with its own kernel' '--from:the system of a wormhole'
			'--memory:memory limit (512M, 2G)' '--pids:most processes and threads'
			'--cpus:virtual CPUs (--vm)')
		_describe -t options 'option' opts
	else
		_bh_names
	fi
	;;
put) (( CURRENT == 3 )) && _bh_names || _files ;;
close) (( CURRENT == 3 )) && _bh_names ;;
esac
