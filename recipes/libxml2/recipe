name=libxml2
version=2.15.4
description="XML parsing library"
depends=(glibc zlib)
# GNOME publishes no signatures; matches the release's sha256sum file.
source=(https://download.gnome.org/sources/libxml2/${version%.*}/libxml2-$version.tar.xz)
sha256=(98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821)

build() {
	meson_build -Dpython=disabled -Dicu=disabled -Dreadline=disabled \
		-Dhistory=disabled -Ddocs=disabled -Dhttp=disabled -Dzlib=enabled \
		-Dmodules=disabled
}

package() {
	meson_package
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/man" "$pkgdir/usr/lib/cmake"
}
