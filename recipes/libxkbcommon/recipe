name=libxkbcommon
version=1.13.2
description="Keyboard keymap handling library"
depends=(glibc xkeyboard-config)
# Upstream publishes no signature: checksum pinned from the release download.
source=(libxkbcommon-$version.tar.gz::https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-$version.tar.gz)
sha256=(acc4d5f7c3cbba5f9f8d08d8bdbeede84ecede46792f47929aa9321873385528)

build() {
	meson_build -Denable-x11=false -Denable-wayland=false -Denable-docs=false \
		-Denable-xkbregistry=false -Denable-tools=false \
		-Denable-bash-completion=false \
		-Dxkb-config-root=/usr/share/xkeyboard-config-2 \
		-Dx-locale-root=/usr/share/X11/locale
	# Paths taken from xkeyboard-config's pkg-config file carry the sysroot.
	sed -i "s|$SYSROOT||g" build/config.h
	ninja -C build -j"$JOBS"
}

package() {
	meson_package
}
