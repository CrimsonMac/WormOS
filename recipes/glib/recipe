name=glib
version=2.90.1
description="General-purpose utility library (GLib, GObject, GIO)"
depends=(glibc libffi pcre2 zlib)
# GNOME publishes no signatures; matches the release's sha256sum file.
source=(https://download.gnome.org/sources/glib/${version%.*}/glib-$version.tar.xz)
sha256=(93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396)

build() {
	meson_build -Dselinux=disabled -Dxattr=true -Dlibmount=disabled \
		-Dman-pages=disabled -Ddtrace=disabled -Dsystemtap=disabled \
		-Dsysprof=disabled -Ddocumentation=false -Dtests=false \
		-Dinstalled_tests=false -Dnls=disabled -Dglib_debug=disabled \
		-Dlibelf=disabled -Dintrospection=disabled
}

package() {
	meson_package
	rm -rf "$pkgdir/usr/share/gdb" "$pkgdir/usr/share/bash-completion" \
		"$pkgdir/usr/share/gettext" "$pkgdir/usr/libexec/installed-tests"
}
