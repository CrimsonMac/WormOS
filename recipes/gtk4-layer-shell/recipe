name=gtk4-layer-shell
version=1.3.0
description="Panels, docks and backgrounds with GTK 4 (wlr-layer-shell)"
depends=(glibc gtk4 wayland)
# Upstream publishes no signature: checksum pinned from the release download
# (it matches Arch Linux's package).
source=(gtk4-layer-shell-$version.tar.gz::https://github.com/wmww/gtk4-layer-shell/archive/v$version.tar.gz)
sha256=(1ebb01ab14e98afd1727f68f64981c37bd23305b1f131f5667c02b94cf593192)

build() {
	meson_build -Dexamples=false -Ddocs=false -Dtests=false -Dsmoke-tests=false \
		-Dintrospection=false -Dvapi=false
}

package() {
	meson_package
}
