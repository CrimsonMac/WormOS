name=worm
version=0.1.0
release=9
description="WormOS system features (worm status, panic, fw, unlock, lock, the power button)"
depends=(glibc snap nftables libxcrypt)
# Builds src/worm, which also uses sources from src/common.
localsrc=src

build() {
	make -C worm CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	make -C worm DESTDIR="$pkgdir" install
	install -Dm644 "$recipedir/files/03-powerkey" "$pkgdir/etc/worm/services/03-powerkey"
}
