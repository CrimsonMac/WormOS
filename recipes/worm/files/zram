#!/bin/sh
# Swap on /dev/zram0: compressed (zstd) in memory, never on disk. Half the
# memory by default (at most 8 GiB), or the size in /etc/worm/zram; "off"
# there turns it off. Swapped pages stay in RAM, so WormOS Amnesia keeps
# its promise; blackholes still never swap (their cgroup says so).
dev=/sys/block/zram0
[ -d "$dev" ] || exit 0
setting=$(sed -n '1{s/[[:space:]]//g;p}' /etc/worm/zram 2>/dev/null)
[ "$setting" = off ] && exit 0
grep -q '^/dev/zram0 ' /proc/swaps && exit 0
if [ -n "$setting" ]; then
	size=$setting
else
	kb=$(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' /proc/meminfo)
	kb=$((kb / 2))
	[ "$kb" -gt 8388608 ] && kb=8388608
	size=${kb}K
fi
echo zstd > "$dev/comp_algorithm" 2> /dev/null
echo "$size" > "$dev/disksize" || exit 1
mkswap /dev/zram0 > /dev/null || exit 1
swapon -p 100 /dev/zram0 2> /dev/null || swapon /dev/zram0 || exit 1
# Swapping to memory is cheap: use it before dropping file caches, and one
# page at a time.
echo 100 > /proc/sys/vm/swappiness
echo 0 > /proc/sys/vm/page-cluster
