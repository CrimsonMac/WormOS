name=sqlite
version=3.54.1
description="SQLite database library and its shell"
depends=(glibc readline ncurses zlib)
source=(https://www.sqlite.org/2026/sqlite-autoconf-3540100.tar.gz)
sha256=(926ef8d3eab93fbf6e06011901273eec076b25594a4e1cdadd50c987f4f6d64e)

build() {
	CFLAGS="$CFLAGS -DSQLITE_ENABLE_COLUMN_METADATA=1 -DSQLITE_ENABLE_UNLOCK_NOTIFY=1 \
		-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_SECURE_DELETE=1" \
	./configure --build="$(gcc -dumpmachine)" --host="$TARGET" --prefix=/usr \
		--disable-static --enable-fts5 \
		--with-readline-ldflags="-lreadline -lncursesw" --with-readline-cflags="-I$SYSROOT/usr/include"
	make -j"$JOBS"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
	rm -rf "$pkgdir/usr/share/man"
}
