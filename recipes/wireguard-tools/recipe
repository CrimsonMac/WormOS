name=wireguard-tools
version=1.0.20260223
description="wg: configures WireGuard VPN interfaces"
depends=(glibc)
source=(https://git.zx2c4.com/wireguard-tools/snapshot/wireguard-tools-$version.tar.xz)
sha256=(af459827b80bfd31b83b08077f4b5843acb7d18ad9a33a2ef532d3090f291fbf)

build() {
	# Through the environment: the Makefile adds to CFLAGS.
	CC="$CC" make -C src wg
}

package() {
	install -Dm755 src/wg "$pkgdir/usr/bin/wg"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/wireguard-tools/COPYING"
}
