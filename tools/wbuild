#!/bin/bash
# wbuild - build a WormOS package from its recipe.
#
# Usage: tools/wbuild NAME...
#
# A recipe lives in recipes/NAME/recipe and is a bash script that sets:
#
#   name, version       package name and version
#   release             package release, bumped when the recipe changes (default 1)
#   description         one-line summary
#   depends=(NAME...)   packages needed at run time
#   caps=("PATH CAPS"...)  file capabilities, e.g. "usr/bin/dumpcap cap_net_raw=ep"
#   groups=(NAME...)    system groups the package needs
#   users=(NAME...)     system users (with a group of the same name) for daemons
#   sysroot_files=(PATH...)  extra files or directories later builds need
#                       (headers, libraries and pkg-config files go anyway)
#   source=(URL...)     archives to download (the first one is unpacked);
#                       NAME::URL stores the download as NAME
#   sha256=(SUM...)     checksums, one per source
#   localsrc=PATH       alternatively, a source tree inside this repository
#   noextract=1         leave the sources in $SOURCES; build() takes what it
#                       needs from them (for large archives)
#
# and defines two functions, run from the unpacked source directory:
#
#   build()             compile
#   package()           install into "$pkgdir"
#
# Recipes can use $recipedir (the recipe's directory, for extra files),
# $srcdir, $pkgdir, $TARGET, $SYSROOT and $JOBS. CC, CXX and friends point
# at the WormOS cross toolchain.
#
# A source that is not an archive is copied into $srcdir instead of being
# unpacked. After packaging, the package's headers and libraries are added
# to the sysroot so later recipes can build against them; build packages in
# dependency order.

. "$(dirname "$0")/../scripts/env.sh"

[ $# -gt 0 ] || die "usage: wbuild NAME..."
[ -x "$TOOLS/bin/$TARGET-gcc" ] || die "toolchain missing, run scripts/build-toolchain.sh first"

# Source paths end up in binaries (__FILE__ in asserts): record them as
# /usr/src/NAME and /usr/include rather than paths on the build machine.
# The flags go in through wrappers, not CFLAGS, because some packages
# (OpenSSL, curl-config) record their CFLAGS.
wrapdir=$BUILD/host/cc
mkdir -p "$wrapdir"
for tool in gcc g++ c++ cpp; do
	cat > "$wrapdir/$TARGET-$tool.new.$$" <<-EOF
	#!/bin/sh
	exec "$TOOLS/bin/$TARGET-$tool" -ffile-prefix-map="$WORK"=/usr/src \\
		-ffile-prefix-map="$SYSROOT"= "\$@"
	EOF
	chmod 755 "$wrapdir/$TARGET-$tool.new.$$"
	mv "$wrapdir/$TARGET-$tool.new.$$" "$wrapdir/$TARGET-$tool"
done
export PATH=$wrapdir:$PATH

export CC="$TARGET-gcc" CXX="$TARGET-g++" AR="$TARGET-ar" AS="$TARGET-as"
export LD="$TARGET-ld" NM="$TARGET-nm" RANLIB="$TARGET-ranlib"
export STRIP="$TARGET-strip" OBJCOPY="$TARGET-objcopy"
export CFLAGS="-O2 -pipe -fstack-protector-strong -fstack-clash-protection -fcf-protection -D_FORTIFY_SOURCE=3"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-Wl,-O1,--as-needed,-z,relro,-z,now"
export PKG_CONFIG_SYSROOT_DIR=$SYSROOT
export PKG_CONFIG_LIBDIR=$SYSROOT/usr/lib/pkgconfig:$SYSROOT/usr/share/pkgconfig

# Meson: the cross file describes the target; tools that run during the
# build (wayland-scanner and the like) come from $NATIVE, built for this
# machine by the recipes that need them.
NATIVE=$BUILD/host/native
mkdir -p "$NATIVE/bin" "$NATIVE/lib/pkgconfig" "$NATIVE/share/pkgconfig"
cat > "$BUILD/host/meson-cross.ini" <<EOF
[binaries]
c = '$TARGET-gcc'
cpp = '$TARGET-g++'
ar = '$TARGET-ar'
strip = '$TARGET-strip'
pkg-config = 'pkg-config'

[properties]
sys_root = '$SYSROOT'
pkg_config_libdir = '$PKG_CONFIG_LIBDIR'

[host_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
EOF
NATIVE_PKG_CONFIG_LIBDIR=$NATIVE/lib/pkgconfig:$NATIVE/share/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig
# pkg-config for this machine must not see the target's sysroot settings.
cat > "$BUILD/host/native-pkg-config" <<EOF
#!/bin/sh
unset PKG_CONFIG_SYSROOT_DIR PKG_CONFIG_PATH
export PKG_CONFIG_LIBDIR='$NATIVE_PKG_CONFIG_LIBDIR'
exec pkg-config "\$@"
EOF
chmod 755 "$BUILD/host/native-pkg-config"
cat > "$BUILD/host/meson-native.ini" <<EOF
[binaries]
pkg-config = '$BUILD/host/native-pkg-config'
EOF
export PATH=$NATIVE/bin:$PATH NATIVE

# meson_build [OPTION...]: configure and compile a meson project for the
# target in ./build (plain build type: our CFLAGS decide).
meson_build() {
	meson setup build --cross-file "$BUILD/host/meson-cross.ini" \
		--native-file "$BUILD/host/meson-native.ini" \
		--prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var \
		--buildtype=plain -Db_ndebug=true -Dwerror=false --wrap-mode=nodownload \
		-Ddefault_library=shared "$@"
	ninja -C build -j"$JOBS"
}

# host_env CMD...: run a command that builds for this machine (tools the
# build itself needs), without the target's compilers, flags and sysroot.
host_env() {
	env -u CC -u CXX -u AR -u AS -u LD -u NM -u RANLIB -u STRIP -u OBJCOPY \
		-u CFLAGS -u CXXFLAGS -u LDFLAGS -u PKG_CONFIG_SYSROOT_DIR \
		PKG_CONFIG_LIBDIR="$NATIVE_PKG_CONFIG_LIBDIR" \
		"$@"
}

# meson_package: install a meson build into $pkgdir.
meson_package() {
	DESTDIR="$pkgdir" meson install -C build --no-rebuild
}

build_one() (
	local recipedir=$WORMOS_ROOT/recipes/$1
	[ -f "$recipedir/recipe" ] || die "no recipe for $1"

	local name="" version="" release=1 description="" localsrc="" noextract=""
	local -a source=() sha256=() depends=() caps=() groups=() users=() sysroot_files=()
	. "$recipedir/recipe"
	[ "$name" = "$1" ] || die "$1: recipe declares name '$name'"

	srcdir=$WORK/$name
	pkgdir=$PKGDIR/$name
	export recipedir srcdir pkgdir

	msg "Building $name $version"
	local i
	for i in "${!source[@]}"; do
		fetch "${source[$i]}" "${sha256[$i]:?missing checksum for ${source[$i]}}"
	done

	if [ -n "$localsrc" ]; then
		rm -rf "$srcdir"
		cp -r "$WORMOS_ROOT/$localsrc" "$srcdir"
	elif [ ${#source[@]} -gt 0 ] && [ -z "$noextract" ]; then
		case ${source[0]} in
		*.tar.*|*.tgz)
			unpack "$SOURCES/$(srcname "${source[0]}")" "$srcdir" ;;
		*)
			rm -rf "$srcdir"
			mkdir -p "$srcdir"
			cp "$SOURCES/$(srcname "${source[0]}")" "$srcdir/" ;;
		esac
	else
		mkdir -p "$srcdir"
	fi

	rm -rf "$pkgdir"
	mkdir -p "$pkgdir"
	cd "$srcdir"
	if declare -F build >/dev/null; then build; fi
	cd "$srcdir"
	package

	# pkg-config files and *-config scripts record the sysroot paths the
	# package was built against; on the target they are plain /usr paths.
	# (wpack rejects anything that still names the build machine.)
	{ grep -rlIZF -- "$SYSROOT" "$pkgdir" || true; } | xargs -0 -r sed -i "s|$SYSROOT||g"

	# Record what the package installed.
	pkginfo "$name" "$version" "$release" "$description" "${depends[@]}"
	{
		for c in "${caps[@]}"; do echo "cap = $c"; done
		for g in "${groups[@]}"; do echo "group = $g"; done
		for u in "${users[@]}"; do echo "user = $u"; done
	} >> "$BUILD/pkginfo/$name.info"

	# Make headers and libraries available to later builds.
	local d
	for d in usr/include usr/lib usr/share/pkgconfig; do
		if [ -d "$pkgdir/$d" ]; then
			mkdir -p "$SYSROOT/$d"
			cp -a "$pkgdir/$d/." "$SYSROOT/$d/"
		fi
	done
	for d in "${sysroot_files[@]}"; do
		if [ -d "$pkgdir/$d" ]; then
			mkdir -p "$SYSROOT/$d"
			cp -a "$pkgdir/$d/." "$SYSROOT/$d/"
		else
			install -D "$pkgdir/$d" "$SYSROOT/$d"
		fi
	done

	msg "Packaged $name $version"
)

for pkg in "$@"; do
	build_one "$pkg"
done
